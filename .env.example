# Copy to .env.local and fill in your values. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Check Runner ──────────────────────────────────────────────────────────────
# Dedicated test wallet private key (Base mainnet, USDC-funded)
# Never log this. Never store in DB. Never include in error messages.
CORTX_TEST_WALLET_KEY=0x...your-64-char-hex-private-key

# Address to receive test payments (typically derived from the above key)
CORTX_TEST_WALLET_ADDRESS=0x...your-wallet-address

# Payee address for the test service (receives USDC during checks)
CORTX_TEST_PAYEE_ADDRESS=0x...your-payee-address

# Spend caps (USDC)
CORTX_DAILY_SPEND_CAP_USDC=1.00
CORTX_MONTHLY_SPEND_CAP_USDC=10.00

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token

# ── Cron Security ─────────────────────────────────────────────────────────────
# Random 32-byte hex string. Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# ── Dev Helpers ───────────────────────────────────────────────────────────────
# Set to "true" to skip on-chain payment verification in the test service
# (useful for local development without a funded wallet)
CORTX_SKIP_PAYMENT_VERIFY=false
