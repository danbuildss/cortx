# /etc/cori/cori.env — Cori's only configuration on the server (root-only, mode 600).
#
# Cori holds NO keys: no wallet key, no Supabase service-role key, no Telegram
# token. It refuses to start if a *PRIVATE_KEY* / *SERVICE_ROLE* / *WALLET* /
# MNEMONIC / SEED_PHRASE variable is set here.
#
# The only secret is the cori_agent database password. Set it yourself in the
# Supabase SQL editor (alter role cori_agent with login password '...'), keep
# it in your password manager, and paste it below. Use letters and digits only
# (30+ characters) so it needs no URL-encoding. Never paste it into chat or GitHub.

# Direct connection (IPv6; Hetzner servers have IPv6):
CORI_DATABASE_URL=postgresql://cori_agent:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# If the direct connection fails, the session pooler (IPv4) instead — copy the
# host from Supabase → Connect → Session pooler, and note the user is cori_agent.PROJECT_REF:
# CORI_DATABASE_URL=postgresql://cori_agent.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Do NOT set CORI_DRY_RUN here: use `systemctl start cori-dryrun` for dry runs.
# Defaults (spec v2, approved Oct 5) — change only with a reason:
# CORI_MAX_ELIGIBLE_PRICE_USDC=0.05
# CORI_DAILY_QUEUE_CAP=25
# CORI_ALLOWED_PORTS=443
# CORI_MAX_PROBES_PER_HOUR=600
